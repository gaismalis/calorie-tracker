# Plain HTTP on $PORT: the hosting platform's proxy handles HTTPS.
{
	frankenphp
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /app/public
	encode zstd br gzip
	# Installable app: the manifest's type isn't in Caddy's built-in list.
	@manifest path /manifest.webmanifest
	header @manifest Content-Type application/manifest+json
	php_server
}
