{% extends 'base.html.twig' %}

{% block title %}My recipes · Calorie Tracker{% endblock %}

{# Meals you eat often, with your own numbers. Logged from the meal dialog without the AI. New and Edit open in the dialog. #}
{% block body %}
{% import 'dashboard/_macros.html.twig' as m %}
<div data-controller="entry-dialog" data-action="turbo:frame-load->entry-dialog#loaded">
    <section class="card recipes">
        <div class="recipes-header">
            <h2>My recipes</h2>
            <a href="{{ path('app_recipe_new') }}" class="button" data-action="entry-dialog#open">＋ New recipe</a>
        </div>
        <p class="muted small">Meals you eat often, with your own exact numbers: log them from <strong>＋ Meal</strong> in one tap, without the AI. Or save a logged meal with {{ m.bookmark_icon(false) }} in the day's log.</p>
        {% for recipe in recipes %}
            <article class="recipe">
                <header>
                    <span class="recipe-title">{{ recipe.name }}</span>
                    <span class="kcal">{{ recipe.kcal|round }} kcal</span>
                    <a href="{{ path('app_recipe_edit', {id: recipe.id}) }}" class="adjust-link" data-action="entry-dialog#open">Edit</a>
                    <form method="post" action="{{ path('app_recipe_delete', {id: recipe.id}) }}" data-controller="confirm-delete">
                        <input type="hidden" name="_token" value="{{ csrf_token('recipe_delete_' ~ recipe.id) }}">
                        <button type="submit" class="link danger" title="Delete" data-confirm-delete-target="button" data-action="confirm-delete#click">✕</button>
                    </form>
                </header>
                <p class="muted small recipe-macros">P {{ recipe.protein|round }} g · C {{ recipe.carbs|round }} g · F {{ recipe.fat|round }} g ·
                    {{ recipe.items|map(item => item.name ~ ' ' ~ item.grams|round ~ ' g')|join(', ') }}</p>
            </article>
        {% else %}
            <p class="muted empty">No recipes yet. Add the things you eat often: your usual breakfast, a protein shake, coffee with milk.</p>
        {% endfor %}
    </section>

    <dialog class="entry-dialog" data-entry-dialog-target="dialog" aria-labelledby="entry-title"
            data-action="pointerdown->entry-dialog#pressed click->entry-dialog#backdrop close->entry-dialog#closed">
        <turbo-frame id="entry-panel" data-entry-dialog-target="frame" data-action="turbo:frame-missing->entry-dialog#leaveFrame"></turbo-frame>
    </dialog>
</div>
{% endblock %}
