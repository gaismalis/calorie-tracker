<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Calorie Tracker{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🥗</text></svg>">
        {% block head %}{% endblock %}
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="topbar">
            <a href="{{ path('app_dashboard') }}" class="brand">🥗 Calorie Tracker</a>
            {% if app.user %}
                <nav>
                    <a href="{{ path('app_dashboard') }}">Today</a>
                    <a href="{{ path('app_weight') }}">Weight</a>
                    <a href="{{ path('app_profile') }}">Profile</a>
                    <span class="muted user-email">{{ app.user.email }}</span>
                    <a href="{{ path('app_logout') }}" class="logout">Log out</a>
                </nav>
            {% endif %}
        </header>
        <main class="container">
            {% if app.user and not app.user.verified and app.request.attributes.get('_route') starts with 'app_' and app.request.attributes.get('_route') != 'app_onboarding' %}
                <div class="verify-banner">
                    <span>Please confirm your email address: we sent a link to <strong>{{ app.user.email }}</strong>.</span>
                    <form method="post" action="{{ path('app_verify_email_resend') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('verify_email_resend') }}">
                        <button type="submit" class="link">Send it again</button>
                    </form>
                </div>
            {% endif %}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ type }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
