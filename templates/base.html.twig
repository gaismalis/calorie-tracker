<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Calorie Tracker{% endblock %}</title>
        <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
        <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png">
        {# Installable as a phone/desktop app (PWA): public/manifest.webmanifest, public/sw.js, public/icons/. #}
        <link rel="manifest" href="/manifest.webmanifest">
        <meta name="theme-color" content="#2f855a">
        <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
        <meta name="apple-mobile-web-app-title" content="Calories">
        <meta name="mobile-web-app-capable" content="yes">
        {% block head %}{% endblock %}
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="topbar">
            <a href="{{ path('app_dashboard') }}" class="brand">🥗 Calorie Tracker</a>
            {% if app.user %}
                <nav>
                    <a href="{{ path('app_dashboard') }}">Today</a>
                    <a href="{{ path('app_weight') }}">Weight</a>
                    <a href="{{ path('app_profile') }}">Profile</a>
                    <span class="muted user-email">{{ app.user.email }}</span>
                    <a href="{{ path('app_logout') }}" class="logout">Log out</a>
                </nav>
            {% endif %}
        </header>
        <main class="container">
            {% if app.user and not app.user.verified and app.request.attributes.get('_route') starts with 'app_' and app.request.attributes.get('_route') != 'app_onboarding' %}
                <div class="verify-banner">
                    <span>Please confirm your email address: we sent a link to <strong>{{ app.user.email }}</strong>.</span>
                    <form method="post" action="{{ path('app_verify_email_resend') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('verify_email_resend') }}">
                        <button type="submit" class="link">Send it again</button>
                    </form>
                </div>
            {% endif %}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ type }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
