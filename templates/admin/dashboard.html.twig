{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Overview{% endblock %}

{% block main %}
    <div class="row g-3">
        {% for label, value in {'Users': userCount, 'Meals logged': mealCount, 'Meals waiting for the AI': pendingCount, 'Meals that failed': failedCount, 'Weigh-ins': weightCount} %}
            <div class="col-6 col-md-4">
                <div class="card"><div class="card-body">
                    <div class="text-muted small">{{ label }}</div>
                    <div class="fs-3 fw-semibold stat-{{ loop.index }}">{{ value }}</div>
                </div></div>
            </div>
        {% endfor %}
    </div>
    {% if pendingCount > 0 %}
        <p class="mt-3 text-muted">Pending meals are retried by the Messenger worker (<code>make worker</code>). If the number keeps growing, check that the worker is running.</p>
    {% endif %}
{% endblock %}
