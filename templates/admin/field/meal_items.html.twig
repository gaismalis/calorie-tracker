{# Detail page: the AI's per-item breakdown of a meal. #}
{% set items = entity.instance.items %}
{% if items is empty %}
    <span class="text-muted">No items (not estimated)</span>
{% else %}
    <table class="table table-sm mb-0">
        <thead><tr><th>Item</th><th class="text-end">g</th><th class="text-end">kcal</th><th class="text-end">P</th><th class="text-end">C</th><th class="text-end">F</th><th>Assumption</th></tr></thead>
        <tbody>
        {% for item in items %}
            <tr>
                <td>{{ item.name }}</td>
                <td class="text-end">{{ item.grams|round }}</td>
                <td class="text-end">{{ item.kcal|round }}</td>
                <td class="text-end">{{ item.protein|round(1) }}</td>
                <td class="text-end">{{ item.carbs|round(1) }}</td>
                <td class="text-end">{{ item.fat|round(1) }}</td>
                <td class="text-muted">{{ item.assumption }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
