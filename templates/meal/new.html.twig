{% extends 'base.html.twig' %}

{% block title %}Log a meal · Calorie Tracker{% endblock %}

{% block body %}
<section class="card">
    <turbo-frame id="entry-panel">
        {% set placeholder = 'e.g. 400 g yogurt, 50 g jam, 50 g granola and a big tablespoon of peanut butter' %}
        {% set photoPlaceholder = "Anything the photo doesn't show? e.g. cooked in butter, large plate, 2 of them (optional)" %}
        <form method="post" action="{{ path('app_meal_create') }}" class="meal-form" enctype="multipart/form-data"
              data-controller="meal-photo" data-meal-photo-placeholder-value="{{ placeholder }}" data-meal-photo-photo-placeholder-value="{{ photoPlaceholder }}">
            <h2 id="entry-title">{{ day ? 'What did you eat on ' ~ day|date('l', app.user.timezone) ~ '?' : 'What did you eat?' }}</h2>
            <textarea name="description" rows="3" maxlength="1000" required autofocus data-meal-photo-target="text"
                placeholder="{{ placeholder }}"></textarea>
            {# The photo is only used to estimate the meal and is deleted once it's estimated. #}
            <div class="meal-photo">
                {# capture: phones open the camera straight away; computers show a file picker instead. #}
                <label class="button secondary photo-button"><span aria-hidden="true">📷</span> Take photo
                    <input type="file" name="photo" accept="image/*" capture="environment" hidden data-meal-photo-target="input" data-action="change->meal-photo#choose">
                </label>
                <span class="photo-preview" data-meal-photo-target="preview" hidden>
                    <img alt="The meal photo" data-meal-photo-target="image">
                    <button type="button" class="photo-remove" aria-label="Remove the photo" data-action="meal-photo#clear">×</button>
                </span>
                <span class="muted photo-hint">A photo of the plate or the label; add details as text.</span>
            </div>
            {% if recipes is not empty %}
                {# One tap logs a recipe with its own numbers (no AI), at the time below; then the usual review to adjust the amount. #}
                <div class="recipe-picks" role="group" aria-labelledby="recipe-picks-title">
                    <span id="recipe-picks-title" class="muted small">Or one of <a href="{{ path('app_recipes') }}" data-turbo-frame="_top">your recipes</a> (no AI):</span>
                    {% for recipe in recipes %}
                        <button type="submit" class="recipe-pick secondary" formaction="{{ path('app_recipe_log', {id: recipe.id}) }}" formnovalidate>
                            {{ recipe.name }} <span class="muted">{{ recipe.kcal|round }} kcal</span>
                        </button>
                    {% endfor %}
                </div>
            {% endif %}
            <div class="meal-form-row">
                <label class="time">At <input type="time" name="time" aria-label="Time eaten">
                    <span class="muted">{{ day ? 'empty = 12:00' : 'empty = now' }}</span></label>
                {% if day %}<input type="hidden" name="date" value="{{ day|date('Y-m-d', app.user.timezone) }}">{% endif %}
                <input type="hidden" name="_token" value="{{ csrf_token('meal_create') }}">
                <button type="button" class="secondary" data-action="entry-dialog#close">Cancel</button>
                <button type="submit" data-busy-label="Estimating…" data-meal-photo-target="submit">Log meal</button>
            </div>
        </form>
    </turbo-frame>
</section>
{% endblock %}
