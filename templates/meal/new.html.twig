{% extends 'base.html.twig' %}

{% block title %}Log a meal · Calorie Tracker{% endblock %}

{% block body %}
{% import 'dashboard/_macros.html.twig' as m %}
<section class="card">
    <turbo-frame id="entry-panel">
        {% set placeholder = 'e.g. 400 g yogurt, 50 g jam, 50 g granola and a big tablespoon of peanut butter' %}
        {% set photoPlaceholder = "Anything the photo doesn't show? e.g. cooked in butter, large plate, 2 of them (optional)" %}
        <form method="post" action="{{ path('app_meal_create') }}" class="meal-form" enctype="multipart/form-data"
              data-controller="meal-photo{{ recipes is not empty ? ' recipe-pick' }}" data-meal-photo-placeholder-value="{{ placeholder }}" data-meal-photo-photo-placeholder-value="{{ photoPlaceholder }}"
              data-recipe-pick-placeholder-value="{{ placeholder }}" data-recipe-pick-extras-placeholder-value="Anything extra this time? e.g. 40 g granola, a banana (optional)">
            <h2 id="entry-title">{{ day ? 'What did you eat on ' ~ day|date('l', app.user.timezone) ~ '?' : 'What did you eat?' }}</h2>
            {% if recipes is not empty %}
                {# The recipe picked as the base of the meal (no AI for it); the text box is then for what was added this time. #}
                <input type="hidden" name="recipe" value="" data-recipe-pick-target="input">
                <div class="recipe-base" data-recipe-pick-target="base" hidden>
                    <div class="recipe-base-head">
                        <span class="recipe-base-icon">{{ m.bookmark_icon(true) }}</span>
                        <strong data-recipe-pick-target="baseName"></strong>
                        <span class="muted" data-recipe-pick-target="baseKcal"></span>
                        <button type="button" class="link" aria-label="Don't use this recipe" title="Don't use this recipe" data-action="recipe-pick#clear">✕</button>
                    </div>
                    <div class="muted small" data-recipe-pick-target="baseItems"></div>
                </div>
            {% endif %}
            <textarea name="description" rows="3" maxlength="1000" required autofocus data-meal-photo-target="text" data-recipe-pick-target="text"
                placeholder="{{ placeholder }}" data-action="input->recipe-pick#filter"></textarea>
            {% if recipes is not empty %}
                {# Your recipes: all of them (scrollable) while the text box is empty; while typing, only those matching the words (name or foods). #}
                <div class="recipe-picks" data-recipe-pick-target="picks">
                    <div class="recipe-picks-title muted small">
                        <span data-recipe-pick-target="title">Your recipes (no AI):</span>
                        <a href="{{ path('app_recipes') }}" data-turbo-frame="_top">Edit</a>
                    </div>
                    <ul class="recipe-list">
                        {% for recipe in recipes %}
                            <li data-recipe-pick-target="option" data-id="{{ recipe.id }}" data-name="{{ recipe.name }}" data-kcal="{{ recipe.kcal|round }} kcal"
                                data-items="{{ recipe.items|map(item => item.name ~ ' ' ~ item.grams|round ~ ' g')|join(', ') }}"
                                data-search="{{ ([recipe.name]|merge(recipe.items|map(item => item.name)))|join(' ') }}">
                                <button type="button" class="recipe-option" data-action="recipe-pick#pick">
                                    <span>{{ recipe.name }}</span> <span class="muted">{{ recipe.kcal|round }} kcal</span>
                                </button>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
            {# The photo is only used to estimate the meal and is deleted once it's estimated. #}
            <div class="meal-photo">
                {# capture: phones open the camera straight away; computers show a file picker instead. #}
                <label class="button secondary photo-button"><span aria-hidden="true">📷</span> Take photo
                    <input type="file" name="photo" accept="image/*" capture="environment" hidden data-meal-photo-target="input" data-action="change->meal-photo#choose">
                </label>
                <span class="photo-preview" data-meal-photo-target="preview" hidden>
                    <img alt="The meal photo" data-meal-photo-target="image">
                    <button type="button" class="photo-remove" aria-label="Remove the photo" data-action="meal-photo#clear">×</button>
                </span>
                <span class="muted photo-hint">A photo of the plate or the label; add details as text.</span>
            </div>
            <div class="meal-form-row">
                <label class="time">At <input type="time" name="time" aria-label="Time eaten">
                    <span class="muted">{{ day ? 'empty = 12:00' : 'empty = now' }}</span></label>
                {% if day %}<input type="hidden" name="date" value="{{ day|date('Y-m-d', app.user.timezone) }}">{% endif %}
                <input type="hidden" name="_token" value="{{ csrf_token('meal_create') }}">
                <button type="button" class="secondary" data-action="entry-dialog#close">Cancel</button>
                <button type="submit" data-busy-label="Estimating…" data-meal-photo-target="submit">Log meal</button>
            </div>
        </form>
    </turbo-frame>
</section>
{% endblock %}
