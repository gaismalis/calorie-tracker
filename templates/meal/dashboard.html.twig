{% extends 'base.html.twig' %}

{% block head %}
    {% if hasPending %}<meta http-equiv="refresh" content="10">{% endif %}
{% endblock %}

{% block body %}
<nav class="day-nav">
    <a href="{{ previousDayUrl }}" class="prev" title="Previous day">←</a>
    <span class="day-title">{{ isToday ? 'Today' : day|date('l, j F Y', app.user.timezone) }}</span>
    {% if nextDayUrl %}
        <a href="{{ nextDayUrl }}" class="next" title="Next day">→</a>
        <a href="{{ path('app_dashboard') }}" class="to-today">Today</a>
    {% else %}
        <span class="next disabled">→</span>
    {% endif %}
</nav>

<section class="card">
    <h1>{{ isToday ? 'What did you eat?' : 'What did you eat on ' ~ day|date('l', app.user.timezone) ~ '?' }}</h1>
    <form method="post" action="{{ path('app_meal_create') }}" class="meal-form">
        <textarea name="description" rows="3" maxlength="1000" required
            placeholder="e.g. 400 g yogurt, 50 g jam, 50 g granola and a big tablespoon of peanut butter"></textarea>
        <div class="meal-form-row">
            <label class="time">At <input type="time" name="time" aria-label="Time eaten">
                <span class="muted">{{ isToday ? 'empty = now' : 'empty = 12:00' }}</span></label>
            {% if not isToday %}<input type="hidden" name="date" value="{{ day|date('Y-m-d', app.user.timezone) }}">{% endif %}
            <input type="hidden" name="_token" value="{{ csrf_token('meal_create') }}">
            <button type="submit">Log meal</button>
        </div>
    </form>
</section>

<section class="card">
    <h2>{{ isToday ? 'Today' : day|date('l, j F', app.user.timezone) }}</h2>
    {% set adaptive = energy.adaptive %}
    {% if energy.complete %}
        {% set tdee = energy.tdee %}
        {% set remaining = tdee - totals.kcal %}
        <div class="target target-{{ energy.source }}">
            <div class="bar"><div style="width: {{ min(100, totals.kcal / tdee * 100)|round }}%"></div></div>
            <p>
                <strong>{{ totals.kcal|round }}</strong> of ~{{ tdee|round }} kcal ·
                {% if remaining >= 0 %}<strong>{{ remaining|round }}</strong> left{% else %}<strong>{{ (-remaining)|round }}</strong> over{% endif %}
            </p>
            {% if energy.source == 'adaptive' %}
                <p class="muted">
                    ~{{ tdee|round }} kcal/day is what you actually burn, calculated from your last {{ adaptive.days }} days:
                    you ate ~{{ adaptive.averageIntake|round }} kcal/day and your weight trend
                    {% if adaptive.trendChangeKg == 0 %}stayed the same{% else %}went {{ adaptive.trendChangeKg > 0 ? 'up' : 'down' }} {{ adaptive.trendChangeKg|abs|number_format(1) }} kg{% endif %}.
                    {% if energy.formulaTdee %}(The formula estimate was ~{{ energy.formulaTdee|round }}.){% endif %}
                </p>
            {% else %}
                <p class="muted">~{{ tdee|round }} kcal/day is a formula estimate of what you burn (maintenance).
                    {{ _self.adaptive_progress(adaptive) }}</p>
            {% endif %}
        </div>
    {% else %}
        {% set profileMissing = energy.missing|filter(m => m != 'weight') %}
        <p class="muted target-missing">
            To see your daily calorie target,
            {% if profileMissing is not empty %}add your {{ profileMissing|join(', ', ' and ') }} in your <a href="{{ path('app_profile') }}">profile</a>{% endif %}
            {%- if profileMissing is not empty and 'weight' in energy.missing %} and {% endif %}
            {%- if 'weight' in energy.missing %}log your <a href="{{ path('app_weight') }}">weight</a>{% endif %}.
        </p>
    {% endif %}
    <div class="totals">
        <div><strong>{{ totals.kcal|round }}</strong><span>kcal</span></div>
        <div><strong>{{ totals.protein|round }} g</strong><span>protein</span></div>
        <div><strong>{{ totals.carbs|round }} g</strong><span>carbs</span></div>
        <div><strong>{{ totals.fat|round }} g</strong><span>fat</span></div>
    </div>

    {% for entry in entries %}
        <article class="entry entry-{{ entry.status.value }}">
            <header>
                <span class="time">{{ entry.eatenAt|date('H:i', app.user.timezone) }}</span>
                <span class="raw">“{{ entry.rawText }}”</span>
                {% if entry.estimatedBy == 'random' %}<span class="badge" title="Numbers from the random fake provider">fake</span>{% endif %}
                {% if entry.pending %}
                    <span class="status">⏳ Estimating…</span>
                {% elseif entry.failed %}
                    <span class="status failed">Couldn't estimate</span>
                {% else %}
                    <span class="kcal">{{ entry.kcal|round }} kcal</span>
                    <a href="{{ path('app_meal_edit', {id: entry.id}) }}" class="adjust-link" title="Adjust amounts">Adjust</a>
                {% endif %}
                <form method="post" action="{{ path('app_meal_delete', {id: entry.id}) }}" data-controller="confirm-delete">
                    <input type="hidden" name="_token" value="{{ csrf_token('meal_delete_' ~ entry.id) }}">
                    <button type="submit" class="link danger" title="Delete" data-confirm-delete-target="button" data-action="confirm-delete#click">✕</button>
                </form>
            </header>
            {% if entry.failed %}
                <div class="retry">
                    <form method="post" action="{{ path('app_meal_retry', {id: entry.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('meal_retry_' ~ entry.id) }}">
                        {% if retryAvailableAt[entry.id] is null %}
                            <button type="submit">Retry</button>
                        {% else %}
                            <button type="submit" disabled>Retry</button>
                            <span class="muted">You can retry at {{ retryAvailableAt[entry.id]|date('H:i', app.user.timezone) }}.</span>
                        {% endif %}
                    </form>
                </div>
            {% elseif not entry.pending %}
            <table>
                <thead>
                    <tr><th>Item</th><th>g</th><th>kcal</th><th>P</th><th>C</th><th>F</th></tr>
                </thead>
                <tbody>
                {% for item in entry.items %}
                    <tr>
                        <td>
                            {{ item.name }}
                            {% if item.assumption %}<div class="assumption">{{ item.assumption }}</div>{% endif %}
                        </td>
                        <td>{{ item.grams|round }}</td>
                        <td>{{ item.kcal|round }}</td>
                        <td>{{ item.protein|round(1) }}</td>
                        <td>{{ item.carbs|round(1) }}</td>
                        <td>{{ item.fat|round(1) }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            {% endif %}
        </article>
    {% else %}
        <p class="muted">Nothing logged {{ isToday ? 'yet today' : 'on this day' }}.</p>
    {% endfor %}
</section>
{% endblock %}

{% macro adaptive_progress(adaptive) %}
    {%- if adaptive.missing == 'weight' -%}
        <span class="adaptive-progress">Keep logging your weight: in {{ adaptive.daysNeeded }} more {{ adaptive.daysNeeded == 1 ? 'day' : 'days' }} we can calculate it from your own data.</span>
    {%- elseif adaptive.missing == 'meals' -%}
        <span class="adaptive-progress">Log your meals on {{ adaptive.daysNeeded }} more {{ adaptive.daysNeeded == 1 ? 'day' : 'days' }} to get an estimate from your own data.</span>
    {%- elseif adaptive.missing == 'implausible' -%}
        <span class="adaptive-progress">Your logged meals (~{{ adaptive.averageIntake|round }} kcal/day) and weight don't add up yet, so we're not using them. Make sure you log everything you eat.</span>
    {%- endif -%}
{% endmacro %}
