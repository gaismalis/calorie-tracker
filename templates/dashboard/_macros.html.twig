{% macro adaptive_progress(adaptive) %}
    {%- if adaptive.missing == 'weight' -%}
        <span class="adaptive-progress">Keep logging your weight: in {{ adaptive.daysNeeded }} more {{ adaptive.daysNeeded == 1 ? 'day' : 'days' }} we can calculate it from your own data.</span>
    {%- elseif adaptive.missing == 'meals' -%}
        <span class="adaptive-progress">Log your meals on {{ adaptive.daysNeeded }} more {{ adaptive.daysNeeded == 1 ? 'day' : 'days' }} to get an estimate from your own data.</span>
    {%- elseif adaptive.missing == 'implausible' -%}
        <span class="adaptive-progress">Your logged meals (~{{ adaptive.averageIntake|round }} kcal/day) and weight don't add up yet, so we're not using them. Make sure you log everything you eat.</span>
    {%- endif -%}
{% endmacro %}

{# Full-width row under a meal item: "per 100 g: 155 kcal · P 8 · C 48 · F 3" (its own row so it fits on one line on phones). #}
{% macro per100g_row(item, columns) %}
    {% set per = item.per100g %}
    {% if per %}<tr class="per100g-row"><td colspan="{{ columns }}"><span class="per100g">per 100 g: {{ per.kcal|round }} kcal · P {{ per.protein|round(1) }} · C {{ per.carbs|round(1) }} · F {{ per.fat|round(1) }}</span></td></tr>{% endif %}
{% endmacro %}

{# A number with its sign: "+250", "−0.23" (real minus sign), "0". #}
{% macro signed(value, decimals) %}{{ (value < 0 ? '−' : (value > 0 ? '+' : '')) ~ value|abs|number_format(decimals, '.', ' ') }}{% endmacro %}

{# How a meal is shown: what was typed (“2 eggs…”); for photo meals the meal's name, then the note if any:
   "📷 Spaghetti bolognese with salad · “large plate”". "📷 Photo" only until the photo is estimated.
   From a recipe: its name, then what was added: "Greek yogurt bowl + “40 g granola”". #}
{% macro meal_text(entry) %}
    {%- if entry.recipeName -%}
        <span class="recipe-name">{{ entry.recipeName }}</span>
        {%- if entry.fromPhoto %} + 📷{% endif -%}
        {%- if entry.rawText is not empty %} + “{{ entry.rawText }}”{% endif -%}
    {%- elseif entry.fromPhoto -%}
        <span class="photo-mark" title="Logged with a photo">📷</span>{{ entry.title ?? 'Photo' }}
        {%- if entry.rawText is not empty %} <span class="photo-note">· “{{ entry.rawText }}”</span>{% endif -%}
    {%- else -%}
        “{{ entry.rawText }}”
    {%- endif -%}
{% endmacro %}

{# "9 – 15 Oct", "28 Sep – 4 Oct" (plain 'Y-m-d' dates, no timezone conversion). #}
{% macro date_range(from, to) %}{% set fromMonth = from|date('M', false) %}{{ from|date('j', false) }}{{ fromMonth != to|date('M', false) ? ' ' ~ fromMonth }} – {{ to|date('j M', false) }}{% endmacro %}

{# ‹ label › to page through periods (pages: {previous, next} URLs or null). The links stay inside the card's Turbo Frame. #}
{% macro pager(pages, label, name) %}
    <nav class="pager" aria-label="{{ name }}">
        {%- if pages.previous %}<a href="{{ pages.previous }}" class="pager-prev" aria-label="Earlier">‹</a>{% else %}<span class="pager-prev" aria-hidden="true">‹</span>{% endif -%}
        <span class="pager-label">{{ label }}</span>
        {%- if pages.next %}<a href="{{ pages.next }}" class="pager-next" aria-label="Later">›</a>{% else %}<span class="pager-next" aria-hidden="true">›</span>{% endif -%}
    </nav>
{% endmacro %}

{# Bookmark outline (save a meal as a recipe) or filled (logged from My recipes). #}
{% macro bookmark_icon(filled) %}<svg width="15" height="15" viewBox="0 0 24 24" fill="{{ filled ? 'currentColor' : 'none' }}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"/></svg>{% endmacro %}
