{# The last 7 days of the chart above at a glance (App\Summary\WeeklySummary); today is left out until it's over. ‹ › move
   both cards by a week (same "period" frame), and the food review below follows. Dates are plain 'Y-m-d', so no timezone conversion. #}
{% import 'dashboard/_macros.html.twig' as m %}
<section class="card week">
    <div class="week-header">
        <h2>Weekly overview</h2>
        {{ m.pager(weekPages, chartIsLatest ? 'Last 7 days' : m.date_range(week.from, week.to), 'Weeks') }}
    </div>
    {% if week.empty %}
        <p class="muted">Nothing logged in these days yet{% if week.days < 7 %} (today counts once it's over){% endif %}.</p>
    {% else %}
        {% set balance = week.dailyBalance %}
        <div class="week-stats">
            <div>
                <span class="label">Eaten</span>
                <strong>{{ week.averageEaten is not null ? week.averageEaten|number_format(0, '.', ' ') : '–' }}</strong>
                <span class="unit">kcal/day avg</span>
            </div>
            <div>
                <span class="label">Burned</span>
                <strong>{{ week.averageBurned is not null ? week.averageBurned|number_format(0, '.', ' ') : '–' }}</strong>
                <span class="unit">kcal/day avg</span>
            </div>
            <div class="week-balance {{ balance is not null ? (balance <= 0 ? 'deficit' : 'surplus') }}">
                <span class="label">Difference</span>
                <strong>{{ balance is not null ? m.signed(balance, 0) : '–' }}</strong>
                <span class="unit">kcal/day</span>
            </div>
        </div>

        {% set pace = week.expectedKgPerWeek %}
        {% if pace is not null %}
            {% set goal = week.goalKgPerWeek %}
            <p class="week-pace">
                At this pace: <strong>{{ m.signed(pace, 2) }} kg/week</strong>
                · goal {{ goal == 0 ? 'keep your weight' : (goal < 0 ? 'lose ' : 'gain ') ~ goal|abs ~ ' kg/week' }}
                {%- set status = week.goalStatus %}
                — <span class="week-status week-status-{{ status }}">
                {%- if status == 'on_track' %}on track
                {%- elseif status == 'faster' %}{{ goal < 0 ? 'losing' : 'gaining' }} faster than your goal
                {%- elseif status == 'slower' %}{{ goal < 0 ? 'losing' : 'gaining' }} slower than your goal
                {%- elseif goal == 0 %}drifting {{ pace < 0 ? 'down' : 'up' }}
                {%- else %}not {{ goal < 0 ? 'losing' : 'gaining' }} at this pace
                {%- endif %}</span>
            </p>
        {% elseif week.averageBurned is null and week.loggedDays > 0 %}
            <p class="muted">"Burned" appears once we can estimate what you burn (see above).</p>
        {% endif %}

        <ul class="week-facts">
            {% if week.trendChangeKg is not null %}
                <li>Weight trend: <strong>{{ week.trendChangeKg|round(1) == 0 ? 'no change' : m.signed(week.trendChangeKg, 1) ~ ' kg' }}</strong> over these days</li>
            {% endif %}
            {% for kind, kcal in {'🍷 Alcohol': week.alcoholKcal, '🍫 Snacks': week.snackKcal} %}
                {% if week.loggedDays > 0 %}
                    <li>{{ kind }}: {% if kcal > 0 %}<strong>{{ kcal|number_format(0, '.', ' ') }} kcal</strong> ({{ week.share(kcal) }}% of what you ate){% else %}none{% endif %}</li>
                {% endif %}
            {% endfor %}
            <li>Exercise: {% if week.exerciseDays > 0 %}<strong>{{ week.exerciseKcal|number_format(0, '.', ' ') }} kcal</strong> on {{ week.exerciseDays }} {{ week.exerciseDays == 1 ? 'day' : 'days' }}{% else %}none logged{% endif %}</li>
            <li>Meals logged on <strong>{{ week.loggedDays }} of {{ week.days }} days</strong>{% if week.loggedDays > 0 and week.rough %}, so these averages are rough{% endif %}{% if week.days < 7 %} (today counts once it's over){% endif %}</li>
        </ul>

        {% if week.loggedDays > 0 %}
            {# Loaded separately (it may ask the AI), only when scrolled into view. #}
            <turbo-frame id="food-review" src="{{ path('app_food_review', {from: week.from, to: week.to}) }}" loading="lazy">
                <div class="food-review"><h3>Food quality</h3><p class="muted">Looking at what you ate…</p></div>
            </turbo-frame>
        {% endif %}
    {% endif %}
</section>
