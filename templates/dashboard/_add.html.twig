{# Floating "+" (narrow screens) → Meal or Exercise → one dialog. Its Turbo frame loads the form, then the "we think it's X kcal" review. #}
<div class="add-entry">
    <div class="add-menu" data-entry-dialog-target="menu" hidden>
        <a href="{{ path('app_meal_new', dateParam) }}" role="button" data-action="entry-dialog#open">🍽 Meal</a>
        <a href="{{ path('app_exercise_new', dateParam) }}" role="button" data-action="entry-dialog#open">🏃 Exercise</a>
        <a href="{{ path('app_weight_quick', dateParam) }}" role="button" data-action="entry-dialog#open">⚖️ Weight</a>
    </div>
    <button type="button" class="fab" aria-label="Add a meal, exercise or weight" aria-expanded="false" aria-haspopup="true"
            data-entry-dialog-target="toggle" data-action="entry-dialog#toggle">+</button>
</div>
{# Just for fun: call the cat (at most every 5 minutes, see The Cat in the wiki). The switch above it turns the cat off;
   then only the 🐾 stays, and pressing it turns the cat back on and calls it. #}
<div class="cat-controls">
    {% if app.user.catEnabled %}
        <form method="post" action="{{ path('app_cat_toggle') }}" class="cat-toggle">
            <input type="hidden" name="_token" value="{{ csrf_token('cat_toggle') }}">
            <input type="hidden" name="back" value="{{ app.request.requestUri }}">
            <input type="hidden" name="enabled" value="0">
            <button type="submit" role="switch" aria-checked="true" aria-label="Cat" title="Turn the cat off"><span class="cat-toggle-knob"></span></button>
        </form>
        <button type="button" class="cat-call" aria-label="Call the cat" title="Call the cat"
                data-controller="cat-call" data-action="cat-call#call"><span aria-hidden="true">🐾</span></button>
    {% else %}
        <form method="post" action="{{ path('app_cat_toggle') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('cat_toggle') }}">
            <input type="hidden" name="back" value="{{ app.request.requestUri }}">
            <input type="hidden" name="enabled" value="1">
            <button type="submit" class="cat-call" aria-label="Turn the cat on and call it" title="Call the cat"
                    data-controller="cat-call" data-action="cat-call#wake"><span aria-hidden="true">🐾</span></button>
        </form>
    {% endif %}
</div>

<dialog class="entry-dialog" data-entry-dialog-target="dialog" aria-labelledby="entry-title"
        data-action="pointerdown->entry-dialog#pressed click->entry-dialog#backdrop close->entry-dialog#closed">
    <turbo-frame id="entry-panel" data-entry-dialog-target="frame" data-action="turbo:frame-missing->entry-dialog#leaveFrame"></turbo-frame>
</dialog>
