{# What was eaten each day (bars) against what was burned that day (dark mark; not the goal-adjusted target). Less = accent green, more = series-2 orange plus a "+N" label, so colour isn't the only cue. #}
<section class="card">
    <h2>Last 14 days</h2>
    {# Wide and compact (phone) versions; CSS shows the one that fits the screen. #}
    {% for chart in charts %}
        <div class="viz-root energy-chart {{ chart.compact ? 'chart-compact' : 'chart-wide' }}" data-controller="chart-hover" data-chart-hover-days-value="{{ chart.hover|json_encode }}">
            <ul class="legend" aria-label="Legend">
                {% if chart.hasBurned %}
                    <li><svg width="10" height="10" aria-hidden="true"><rect width="10" height="10" class="bar-under"/></svg> Ate less than burned</li>
                    <li><svg width="10" height="10" aria-hidden="true"><rect width="10" height="10" class="bar-over"/></svg> Ate more</li>
                    <li><svg width="16" height="10" aria-hidden="true"><line x1="0" y1="5" x2="16" y2="5" class="burned-mark"/></svg> Burned</li>
                {% else %}
                    <li><svg width="10" height="10" aria-hidden="true"><rect width="10" height="10" class="bar-unknown"/></svg> Eaten</li>
                {% endif %}
            </ul>
            <svg viewBox="0 0 {{ chart.width }} {{ constant('App\\Chart\\EnergyChart::HEIGHT') }}"
                 role="img" aria-label="Calories eaten per day for the last 14 days{{ chart.hasBurned ? ', compared with calories burned' }}"
                 data-chart-hover-target="svg">
                <g class="grid">
                    {% for tick in chart.yTicks %}
                        <line x1="{{ chart.plotLeft }}" x2="{{ chart.plotRight }}" y1="{{ tick.y }}" y2="{{ tick.y }}"/>
                        <text x="{{ chart.plotLeft - 8 }}" y="{{ tick.y }}" class="y-tick">{{ tick.value|number_format(0, '.', ' ') }}</text>
                    {% endfor %}
                </g>
                <g class="x-axis">
                    {% for tick in chart.xTicks %}
                        <text x="{{ tick.x }}" y="{{ chart.plotBottom + 18 }}" class="x-tick">{{ tick.label }}</text>
                    {% endfor %}
                </g>
                {% if chart.empty %}
                    <text x="{{ (chart.plotLeft + chart.plotRight) / 2 }}" y="{{ (chart.plotTop + chart.plotBottom) / 2 }}" class="empty-label">{% if chart.compact %}<tspan x="{{ (chart.plotLeft + chart.plotRight) / 2 }}" dy="-0.6em">Nothing logged in these 14 days yet.</tspan><tspan x="{{ (chart.plotLeft + chart.plotRight) / 2 }}" dy="1.3em">Tap + to add a meal.</tspan>{% else %}Nothing logged in these 14 days yet. Tap + to add a meal.{% endif %}</text>
                {% endif %}
                <g class="bars">
                    {% for day in chart.days|filter(day => day.bar) %}
                        <rect x="{{ day.bar.x }}" y="{{ day.bar.y }}" width="{{ day.bar.width }}" height="{{ day.bar.height }}" rx="2"
                              class="bar-{{ day.status }}{{ day.today ? ' bar-today' }}"/>
                        {% if day.overBy and not chart.compact %}
                            <text x="{{ day.x }}" y="{{ day.bar.y - 5 }}" class="over-label">+{{ day.overBy|number_format(0, '.', ' ') }}</text>
                        {% endif %}
                    {% endfor %}
                </g>
                <g class="burned">
                    {% for day in chart.days|filter(day => day.burnedMark) %}
                        <line x1="{{ day.burnedMark.x1 }}" x2="{{ day.burnedMark.x2 }}" y1="{{ day.burnedMark.y }}" y2="{{ day.burnedMark.y }}" class="burned-mark"/>
                    {% endfor %}
                </g>
                <line class="crosshair" data-chart-hover-target="crosshair" y1="{{ chart.plotTop }}" y2="{{ chart.plotBottom }}" x1="0" x2="0" visibility="hidden"/>
                <rect class="hit-area" x="{{ chart.plotLeft }}" y="{{ chart.plotTop }}" width="{{ chart.plotRight - chart.plotLeft }}" height="{{ chart.plotBottom - chart.plotTop }}"
                      tabindex="0" aria-label="Explore the chart with the arrow keys"
                      data-action="pointermove->chart-hover#move pointerleave->chart-hover#hide focus->chart-hover#focus blur->chart-hover#hide keydown->chart-hover#key"/>
            </svg>
            <div class="tooltip" data-chart-hover-target="tooltip" hidden></div>
        </div>
    {% endfor %}
    {% if not energy.complete %}
        <p class="muted chart-note">"Burned" appears once we can estimate what you burn (see above).</p>
    {% elseif charts|first.days|filter(day => day.today and day.bar)|length > 0 %}
        <p class="muted chart-note">Today is shown faded until the day is over.</p>
    {% endif %}
</section>
