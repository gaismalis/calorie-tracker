{% extends 'base.html.twig' %}

{% block head %}
    {% if hasPending %}<meta http-equiv="refresh" content="10">{% endif %}
{% endblock %}

{% block body %}
<nav class="day-nav">
    <a href="{{ previousDayUrl }}" class="prev" title="Previous day">←</a>
    <span class="day-title">{{ isToday ? 'Today' : day|date('l, j F Y', app.user.timezone) }}</span>
    {% if nextDayUrl %}
        <a href="{{ nextDayUrl }}" class="next" title="Next day">→</a>
        <a href="{{ path('app_dashboard') }}" class="to-today">Today</a>
    {% else %}
        <span class="next disabled">→</span>
    {% endif %}
</nav>

<div data-controller="entry-dialog"
     data-action="keydown.esc@window->entry-dialog#closeMenu click@window->entry-dialog#outside turbo:frame-load->entry-dialog#loaded">
    {% set dateParam = isToday ? {} : {date: day|date('Y-m-d', app.user.timezone)} %}
    {# Wide screens: buttons above the overview. Narrow screens use the floating + in _add.html.twig instead. #}
    <div class="add-bar">
        <a href="{{ path('app_meal_new', dateParam) }}" class="button" data-action="entry-dialog#open">＋ Meal</a>
        <a href="{{ path('app_exercise_new', dateParam) }}" class="button secondary" data-action="entry-dialog#open">＋ Exercise</a>
        <a href="{{ path('app_weight_quick', dateParam) }}" class="button secondary" data-action="entry-dialog#open">＋ Weight</a>
    </div>
    {{ include('dashboard/_overview.html.twig') }}
    {{ include('dashboard/_chart.html.twig') }}
    {{ include('dashboard/_log.html.twig') }}
    {{ include('dashboard/_add.html.twig') }}
</div>
{% endblock %}
