{% extends 'base.html.twig' %}

{% block title %}Weight · Calorie Tracker{% endblock %}

{% block body %}
<section class="card">
    <h1>Log your weight</h1>
    <p class="muted">Weigh yourself in the morning, after the toilet and before eating, for the most consistent numbers. Logging the same day again replaces the earlier value.</p>
    {{ form_start(form, {attr: {class: 'inline-form'}}) }}
        {{ form_row(form.weightKg) }}
        {{ form_row(form.date) }}
        <button type="submit">Save weight</button>
    {{ form_end(form) }}
</section>

<section class="card">
    <div class="chart-header">
        <h2>Weight and trend</h2>
        <nav class="range" aria-label="Chart range">
            {% for days in ranges %}
                <a href="{{ path('app_weight', {range: days}) }}" {% if days == range %}aria-current="true"{% endif %}>{{ days == 365 ? '1 year' : days ~ ' days' }}</a>
            {% endfor %}
        </nav>
    </div>
    {% if chart %}
        {{ include('weight/_chart.html.twig') }}
    {% else %}
        <p class="muted chart-empty">Log your weight on at least two days in this period to see a chart.</p>
    {% endif %}
</section>

<section class="card">
    <h2>History</h2>
    <p class="muted">Your weight jumps around by up to 1–2 kg a day from water and food. <strong>Trend</strong> smooths that out and is what the app uses to work out what you really burn.</p>
    {% if rows is empty %}
        <p class="muted">No weight logged yet.</p>
    {% else %}
        <table class="weights">
            <thead><tr><th>Date</th><th>kg</th><th>Change</th><th title="Smoothed weight: ignores day-to-day water swings">Trend</th><th></th></tr></thead>
            <tbody>
            {% for row in rows %}
                <tr>
                    <td>{{ row.entry.date|date('D, j M Y', 'UTC') }}</td>
                    <td>{{ row.entry.weightKg|number_format(1) }}</td>
                    <td class="change">
                        {% if row.change is not null %}{{ row.change > 0 ? '+' : '' }}{{ row.change|number_format(1) }}{% endif %}
                    </td>
                    <td class="trend">{% if row.trend is not null %}{{ row.trend|number_format(1) }}{% endif %}</td>
                    <td>
                        <form method="post" action="{{ path('app_weight_delete', {id: row.entry.id}) }}" data-controller="confirm-delete">
                            <input type="hidden" name="_token" value="{{ csrf_token('weight_delete_' ~ row.entry.id) }}">
                            <button type="submit" class="link danger" title="Delete" data-confirm-delete-target="button" data-action="confirm-delete#click">✕</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</section>
{% endblock %}
