{# Weigh-ins (dots, series 2) and trend (line, series 1). Colors validated with the dataviz palette validator. #}
<div class="viz-root weight-chart" data-controller="weight-chart" data-weight-chart-days-value="{{ chart.days|json_encode }}">
    <ul class="legend" aria-label="Legend">
        <li><svg width="16" height="10" aria-hidden="true"><line x1="0" y1="5" x2="16" y2="5" class="trend-line"/></svg> Trend</li>
        <li><svg width="10" height="10" aria-hidden="true"><circle cx="5" cy="5" r="4" class="weigh-in"/></svg> Weigh-ins</li>
    </ul>
    <svg viewBox="0 0 {{ constant('App\\Chart\\WeightChart::WIDTH') }} {{ constant('App\\Chart\\WeightChart::HEIGHT') }}"
         role="img" aria-label="Weight chart: {{ chart.dots|length }} {{ chart.dots|length == 1 ? 'weigh-in' : 'weigh-ins' }}{% if chart.trendEnd %}, trend now {{ chart.trendEnd.kg|number_format(1) }} kg{% endif %}. The same data is in the History table below."
         data-weight-chart-target="svg">
        <g class="grid">
            {% for tick in chart.yTicks %}
                <line x1="{{ chart.plotLeft }}" x2="{{ chart.plotRight }}" y1="{{ tick.y }}" y2="{{ tick.y }}"/>
                <text x="{{ chart.plotLeft - 8 }}" y="{{ tick.y }}" class="y-tick">{{ tick.value == tick.value|round ? tick.value|number_format(0) : tick.value|number_format(1) }}</text>
            {% endfor %}
        </g>
        <g class="x-axis">
            {% for tick in chart.xTicks %}
                <text x="{{ tick.x }}" y="{{ chart.plotBottom + 18 }}" class="x-tick">{{ tick.label }}</text>
            {% endfor %}
        </g>
        {% if chart.empty %}
            <text x="{{ (chart.plotLeft + chart.plotRight) / 2 }}" y="{{ (chart.plotTop + chart.plotBottom) / 2 }}" class="empty-label">No weigh-ins in this period yet. Log your weight above.</text>
        {% endif %}
        <path d="{{ chart.trendPath }}" class="trend-line"/>
        <g class="dots">
            {% for dot in chart.dots %}
                <circle cx="{{ dot.x }}" cy="{{ dot.y }}" r="4" class="weigh-in"/>
            {% endfor %}
        </g>
        {% if chart.trendEnd %}
            <circle cx="{{ chart.trendEnd.x }}" cy="{{ chart.trendEnd.y }}" r="4" class="trend-end"/>
            <text x="{{ chart.trendEnd.x + 10 }}" y="{{ chart.trendEnd.y }}" class="end-label">{{ chart.trendEnd.kg|number_format(1) }} kg</text>
        {% endif %}
        <line class="crosshair" data-weight-chart-target="crosshair" y1="{{ chart.plotTop }}" y2="{{ chart.plotBottom }}" x1="0" x2="0" visibility="hidden"/>
        <rect class="hit-area" x="{{ chart.plotLeft }}" y="{{ chart.plotTop }}" width="{{ chart.plotRight - chart.plotLeft }}" height="{{ chart.plotBottom - chart.plotTop }}"
              tabindex="0" aria-label="Explore the chart with the arrow keys"
              data-action="pointermove->weight-chart#move pointerleave->weight-chart#hide focus->weight-chart#focus blur->weight-chart#hide keydown->weight-chart#key"/>
    </svg>
    <div class="tooltip" data-weight-chart-target="tooltip" hidden></div>
</div>
