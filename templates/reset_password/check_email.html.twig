{% extends 'base.html.twig' %}

{% block title %}Check your email · Calorie Tracker{% endblock %}

{% block body %}
<section class="card narrow">
    <h1>Check your email</h1>
    <p>If an account exists for that address, we've sent a link to reset your password. It's valid for {{ lifetimeMinutes }} minutes.</p>
    <p class="muted">Nothing arrived? Check your spam folder, or <a href="{{ path('app_forgot_password') }}">try again</a> in a few minutes.</p>
</section>
{% endblock %}
