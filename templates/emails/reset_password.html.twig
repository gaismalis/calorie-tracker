{% extends 'emails/_layout.html.twig' %}
{% block content %}
    <h1 style="font-size:20px;margin:0 0 12px;">Reset your password</h1>
    <p>Someone (hopefully you) asked to reset the password for this account.</p>
    <p style="margin:24px 0;">
        <a href="{{ resetUrl }}" style="background:#2f855a;color:#fff;padding:10px 18px;border-radius:6px;text-decoration:none;">Choose a new password</a>
    </p>
    <p style="color:#6b726d;font-size:13px;">This link is valid for 1 hour and works once. If you didn't ask for it, you can ignore this email; your password stays the same.</p>
{% endblock %}
