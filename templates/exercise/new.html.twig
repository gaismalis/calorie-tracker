{% extends 'base.html.twig' %}

{% block title %}Log exercise · Calorie Tracker{% endblock %}

{% block body %}
<section class="card">
    <turbo-frame id="entry-panel">
        <form method="post" action="{{ path('app_exercise_create') }}" class="exercise-form">
            <h2 id="entry-title">{{ day ? 'What did you do on ' ~ day|date('l', app.user.timezone) ~ '?' : 'What did you do?' }}</h2>
            <textarea name="description" rows="3" maxlength="1000" required autofocus
                placeholder="e.g. played basketball for 2 hours, or: workout, burned 600 kcal"></textarea>
            <p class="muted hint">Mention the calories if you know them (e.g. from your watch) and we'll use your number.</p>
            <div class="meal-form-row">
                <label class="time">At <input type="time" name="time" aria-label="Time of exercise">
                    <span class="muted">{{ day ? 'empty = 12:00' : 'empty = now' }}</span></label>
                {% if day %}<input type="hidden" name="date" value="{{ day|date('Y-m-d', app.user.timezone) }}">{% endif %}
                <input type="hidden" name="_token" value="{{ csrf_token('exercise_create') }}">
                <button type="button" class="secondary" data-action="entry-dialog#close">Cancel</button>
                <button type="submit" data-busy-label="Estimating…">Log exercise</button>
            </div>
        </form>
    </turbo-frame>
</section>
{% endblock %}
